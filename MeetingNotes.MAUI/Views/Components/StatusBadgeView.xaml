<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeetingNotes.MAUI.Views.Components.StatusBadgeView"
             x:Name="Self">
    <Border Padding="14,6"
            BackgroundColor="{Binding BadgeBackgroundColor, Source={x:Reference Self}}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 18"
            IsVisible="{Binding IsBadgeVisible, Source={x:Reference Self}}">
        <HorizontalStackLayout Spacing="8">
            <Border WidthRequest="8"
                    HeightRequest="8"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 4"
                    BackgroundColor="{Binding DotColor, Source={x:Reference Self}}" />
            <Label Text="{Binding Text, Source={x:Reference Self}}"
                   FontFamily="OpenSansSemibold"
                   FontSize="14"
                   TextColor="{Binding TextColor, Source={x:Reference Self}}" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
